<tr><td align="center" style="padding:24px 12px;">
<!--[if mso]><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" align="center"><tr><td><![endif]-->
<div style="max-width:600px;margin:0 auto;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;background:#ffffff;border:1px solid #d6d3d1;border-radius:10px;overflow:hidden;">
<tr><td class="bl-pad" style="padding:32px 32px 20px 32px;background:#ffffff;"><p style="margin:0 0 6px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:26px;line-height:1.2;color:#1f2937;">Northfield Arts Society</p><p style="margin:0;font-family:Arial, Helvetica, sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0f766e;font-weight:bold;">Harbour Notes &middot; Autumn 2026</p></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#ffffff;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:24px;line-height:1.25;font-weight:normal;color:#1f2937;">A note from the editor</h2><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td valign="top"><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;">Thank you for a wonderful summer.</p><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;">See you at the fair.</p><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;font-style:italic;">Robin, editor</p></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:20px 32px 20px 32px;background:#ffffff;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:20px;line-height:1.25;font-weight:normal;color:#1f2937;">Opening hours</h2><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;">We open at nine on weekdays.</p></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#1f2937;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:24px;line-height:1.25;font-weight:normal;color:#f5f5f4;">Coming up</h2><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="100%" valign="top" align="center" style="padding:8px 6px;"><p style="margin:0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:56px;line-height:1;color:#f59e0b;">3</p><p style="margin:10px 0 4px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:18px;line-height:1.3;color:#f5f5f4;">Autumn fair</p><p style="margin:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;color:#cbd5e1;">Oct. 3 · 10:00 AM · Town green</p></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#f5f5f4;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:24px;line-height:1.25;font-weight:normal;color:#1f2937;">Say hello</h2><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;">Please join us in welcoming the newest members of our community.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="36" valign="top" style="width:36px;padding:8px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:22px;color:#0f766e;">1.</td><td valign="top" style="padding:8px 0;border-bottom:1px solid #d6d3d1;"><p style="margin:0;font-family:Arial, Helvetica, sans-serif;font-size:16px;font-weight:bold;color:#1f2937;">Harbor Lane Bakery</p><p style="margin:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.5;color:#57534e;">Bakery, joined Sept. 3</p></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#ffffff;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:24px;line-height:1.25;font-weight:normal;color:#1f2937;">With thanks</h2><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td class="bl-stack-xs" width="96" valign="top" style="width:96px;padding:10px 20px 10px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="96" style="width:96px;"><tr><td align="center" valign="middle" width="96" height="96" style="width:96px;height:96px;background:#0f766e;border-radius:8px;font-family:Georgia, 'Times New Roman', Times, serif;font-size:37px;color:#ffffff;">OI</td></tr></table></td><td class="bl-stack-xs" valign="middle" style="padding:10px 0;"><p style="margin:0 0 4px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:18px;color:#1f2937;">Oak and Iron Works</p><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;margin:0;">Thank you for supporting the autumn fair!</p></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#ffffff;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:24px;line-height:1.25;font-weight:normal;color:#1f2937;">Latest news</h2><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="padding:10px 0;border-bottom:1px solid #d6d3d1;"><p style="margin:0 0 2px 0;font-family:Arial, Helvetica, sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#0f766e;font-weight:bold;">Announcement</p><p style="margin:0 0 6px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:19px;line-height:1.3;"><a href="https://example.test/news/library-hours" style="color:#1f2937;text-decoration:none;">New library hours</a></p><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;margin:0 0 6px 0;">The reading room now opens on Sundays.</p><p style="margin:0;font-family:Arial, Helvetica, sans-serif;font-size:13px;line-height:1.5;color:#1f2937;"><a href="https://example.test/news/library-hours" style="color:#1f2937;">Read more</a></p></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#ffffff;"><p style="margin:0 0 8px 0;font-family:Arial, Helvetica, sans-serif;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#0f766e;font-weight:bold;">Tips</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td class="bl-stack bl-space" width="160" valign="top" style="width:160px;padding-right:20px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="160" style="width:160px;"><tr><td align="center" valign="middle" width="160" height="120" style="width:160px;height:120px;background:#1f2937;border-radius:8px;font-family:Georgia, 'Times New Roman', Times, serif;font-size:14px;letter-spacing:1px;color:#f5f5f4;">TIPS</td></tr></table></td><td class="bl-stack" valign="top"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:20px;line-height:1.25;font-weight:normal;color:#1f2937;">Three ways to save energy</h2><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;">Turn the heating down.</p></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#f5f5f4;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:24px;line-height:1.25;font-weight:normal;color:#1f2937;">Around town</h2><p style="margin:-6px 0 12px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:16px;font-style:italic;color:#57534e;">Coming up</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="padding:5px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.5;color:#1f2937;"><strong>Sept. 5</strong> &middot; Farmers market at the square</td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:20px 32px 20px 32px;background:#ffffff;"><h2 style="margin:0 0 14px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:20px;line-height:1.25;font-weight:normal;color:#1f2937;">Have news to share?</h2><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;">Send it our way.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 0 0;"><tr><td style="background:#0f766e;border-radius:6px;"><a href="https://example.test/share" style="display:inline-block;padding:12px 22px;font-family:Arial, Helvetica, sans-serif;font-size:15px;font-weight:bold;color:#ffffff;text-decoration:none;">Share your news</a></td></tr></table></td></tr>
<tr><td class="bl-pad" style="padding:28px 32px 28px 32px;background:#ffffff;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td class="bl-stack bl-space" width="50%" valign="top" style="padding:0;"><p style="margin:0 0 6px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:18px;line-height:1.3;color:#1f2937;">Volunteer</p><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;margin:0 0 8px 0;">Give an hour a month.</p></td><td class="bl-gap" width="16" style="width:16px;font-size:0;line-height:0;">&nbsp;</td><td class="bl-stack" width="50%" valign="top" style="padding:0;"><p style="margin:0 0 6px 0;font-family:Georgia, 'Times New Roman', Times, serif;font-size:18px;line-height:1.3;color:#1f2937;">Donate</p><p style="margin:0 0 12px 0;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.55;color:#1f2937;margin:0 0 8px 0;">Every gift helps.</p></td></tr></table></td></tr>
