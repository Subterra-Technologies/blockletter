# Copy to .env (git-ignored) and fill in to send with `npm run send`.
# Without all three, the script stops after writing out/ and sends nothing.
RESEND_API_KEY=re_your_api_key
FROM=Newsletter <newsletter@your-verified-domain.example>
TO=you@your-domain.example

# Optional: an unsubscribe link for TO, put in the footer and the List-Unsubscribe header.
# A real newsletter must have one; without it the renderer warns and the footer has no link.
UNSUBSCRIBE_URL=
