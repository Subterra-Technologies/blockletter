{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `node`: the client's types reach the Convex functions (through `convex/_generated/api`),
    // and those read their keys from `process.env`.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
